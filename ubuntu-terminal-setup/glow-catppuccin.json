{
  "document":     { "block_prefix": "\n", "block_suffix": "\n", "color": "#cdd6f4", "margin": 2 },
  "block_quote":  { "indent": 1, "indent_token": "▎ ", "color": "#9399b2", "italic": true },
  "paragraph":    {},
  "list":         { "level_indent": 2 },
  "heading":      { "block_suffix": "\n", "bold": true },
  "h1":           { "prefix": " ", "suffix": " ", "color": "#1e1e2e", "background_color": "#f38ba8", "bold": true },
  "h2":           { "prefix": "▌ ", "color": "#fab387" },
  "h3":           { "prefix": "▌ ", "color": "#f9e2af" },
  "h4":           { "prefix": "▌ ", "color": "#a6e3a1" },
  "h5":           { "prefix": "▌ ", "color": "#89b4fa" },
  "h6":           { "prefix": "▌ ", "color": "#cba6f7" },
  "text":         {},
  "strikethrough":{ "crossed_out": true, "color": "#7f849c" },
  "emph":         { "italic": true, "color": "#94e2d5" },
  "strong":       { "bold": true, "color": "#f5c2e7" },
  "hr":           { "color": "#585b70", "format": "\n────────────────────────────────────────\n" },
  "item":         { "block_prefix": "• " },
  "enumeration":  { "block_prefix": ". ", "color": "#fab387" },
  "task":         { "ticked": "[✓] ", "unticked": "[ ] " },
  "link":         { "color": "#89b4fa", "underline": true },
  "link_text":    { "color": "#89b4fa", "bold": true },
  "image":        { "color": "#89b4fa", "underline": true },
  "image_text":   { "color": "#7f849c", "format": "Image: {{.text}} →" },
  "code":         { "prefix": " ", "suffix": " ", "color": "#a6e3a1", "background_color": "#313244" },
  "code_block":   { "color": "#cdd6f4", "margin": 2, "theme": "catppuccin-mocha" },
  "table":        { "color": "#cdd6f4" },
  "definition_list": {},
  "definition_term": {},
  "definition_description": { "block_prefix": "\n🠶 " },
  "html_block":   {},
  "html_span":    {}
}
