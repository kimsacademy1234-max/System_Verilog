         <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
         <obj_property name="CustomSignalColor">#FF66FF</obj_property>
         <obj_property name="UseCustomSignalColor">true</obj_property>
      </wvobject>
      <wvobject fp_name="/tb_fifo/DUT_FIFO/U_REG_FILE/rdata" type="array">
         <obj_property name="ElementShortName">rdata[7:0]</obj_property>
         <obj_property name="ObjectShortName">rdata[7:0]</obj_property>
         <obj_property name="Radix">HEXRADIX</obj_property>
         <obj_property name="CustomSignalColor">#FF66FF</obj_property>
