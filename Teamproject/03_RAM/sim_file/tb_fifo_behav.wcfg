         <obj_property name="ObjectShortName">empty_reg</obj_property>
         <obj_property name="CustomSignalColor">#FFFF00</obj_property>
         <obj_property name="UseCustomSignalColor">true</obj_property>
      </wvobject>
   </wvobject>
   <wvobject fp_name="group5" type="group">
      <obj_property name="label">4. register_file</obj_property>
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="isExpanded"></obj_property>
      <wvobject fp_name="/tb_fifo/DUT_FIFO/U_REG_FILE/we" type="logic">
