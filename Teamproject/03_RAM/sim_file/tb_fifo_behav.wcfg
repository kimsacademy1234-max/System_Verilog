<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="tb_fifo_behav.wdb" id="1">
         <top_modules>
            <top_module name="glbl" />
            <top_module name="tb_fifo" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="0fs"></ZoomStartTime>
      <ZoomEndTime time="240000000fs"></ZoomEndTime>
      <Cursor1Time time="135000fs"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="214"></NameColumnWidth>
      <ValueColumnWidth column_width="103"></ValueColumnWidth>
   </column_width_setting>
   <WVObjectSize size="6" />
   <wave_markers>
      <marker time="220000" label="" />
      <marker time="90000" label="" />
      <marker time="150000" label="" />
   </wave_markers>
   <wvobject fp_name="group1" type="group">
      <obj_property name="label">0. CLK / RST</obj_property>
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="isExpanded"></obj_property>
      <wvobject fp_name="/tb_fifo/i_clk" type="logic">
         <obj_property name="ElementShortName">i_clk</obj_property>
         <obj_property name="ObjectShortName">i_clk</obj_property>
         <obj_property name="CustomSignalColor">#B0B0B0</obj_property>
         <obj_property name="UseCustomSignalColor">true</obj_property>
      </wvobject>
      <wvobject fp_name="/tb_fifo/i_reset" type="logic">
         <obj_property name="ElementShortName">i_reset</obj_property>
         <obj_property name="ObjectShortName">i_reset</obj_property>
         <obj_property name="CustomSignalColor">#B0B0B0</obj_property>
         <obj_property name="UseCustomSignalColor">true</obj_property>
      </wvobject>
   </wvobject>
   <wvobject fp_name="group2" type="group">
      <obj_property name="label">1. INPUT (TB -&gt; FIFO)</obj_property>
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="isExpanded"></obj_property>
      <wvobject fp_name="/tb_fifo/push" type="logic">
         <obj_property name="ElementShortName">push</obj_property>
         <obj_property name="ObjectShortName">push</obj_property>
         <obj_property name="CustomSignalColor">#00FFFF</obj_property>
         <obj_property name="UseCustomSignalColor">true</obj_property>
      </wvobject>
      <wvobject fp_name="/tb_fifo/push_data" type="array">
         <obj_property name="ElementShortName">push_data[7:0]</obj_property>
         <obj_property name="ObjectShortName">push_data[7:0]</obj_property>
         <obj_property name="Radix">HEXRADIX</obj_property>
         <obj_property name="CustomSignalColor">#00FFFF</obj_property>
         <obj_property name="UseCustomSignalColor">true</obj_property>
      </wvobject>
      <wvobject fp_name="/tb_fifo/pop" type="logic">
         <obj_property name="ElementShortName">pop</obj_property>
         <obj_property name="ObjectShortName">pop</obj_property>
         <obj_property name="CustomSignalColor">#00FFFF</obj_property>
         <obj_property name="UseCustomSignalColor">true</obj_property>
      </wvobject>
   </wvobject>
   <wvobject fp_name="group3" type="group">
      <obj_property name="label">2. OUTPUT (FIFO -&gt; TB)</obj_property>
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="isExpanded"></obj_property>
      <wvobject fp_name="/tb_fifo/pop_data" type="array">
         <obj_property name="ElementShortName">pop_data[7:0]</obj_property>
         <obj_property name="ObjectShortName">pop_data[7:0]</obj_property>
         <obj_property name="Radix">HEXRADIX</obj_property>
         <obj_property name="CustomSignalColor">#00FF00</obj_property>
         <obj_property name="UseCustomSignalColor">true</obj_property>
      </wvobject>
      <wvobject fp_name="/tb_fifo/full" type="logic">
         <obj_property name="ElementShortName">full</obj_property>
         <obj_property name="ObjectShortName">full</obj_property>
         <obj_property name="CustomSignalColor">#FF6060</obj_property>
         <obj_property name="UseCustomSignalColor">true</obj_property>
      </wvobject>
      <wvobject fp_name="/tb_fifo/empty" type="logic">
         <obj_property name="ElementShortName">empty</obj_property>
         <obj_property name="ObjectShortName">empty</obj_property>
         <obj_property name="CustomSignalColor">#FF6060</obj_property>
         <obj_property name="UseCustomSignalColor">true</obj_property>
      </wvobject>
   </wvobject>
   <wvobject fp_name="group4" type="group">
      <obj_property name="label">3. control_unit</obj_property>
